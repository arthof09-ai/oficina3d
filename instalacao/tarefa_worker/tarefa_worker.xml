<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modelo da Tarefa Agendada do worker da Oficina 3D (usuário atual, sem admin).
  NÃO importe este arquivo direto: rode registrar_tarefa.cmd, que troca
  __USUARIO__, __APP__ e __BASE__ e grava a versão final em UTF-16.
  - sobe no logon do usuário, 2 minutos depois (não pesa na entrada do Windows);
  - prioridade baixa (8 = abaixo do normal, E/S baixa);
  - sem limite de tempo; uma instância só; reinicia em falha (3x a cada 5 min);
  - o iniciar_worker.py carrega o env.cmd e reinicia o worker se ele cair.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Oficina 3D: worker da fila de jobs. Prioridade baixa; pausa sozinho quando outro programa usa a GPU.</Description>
    <URI>\Oficina3D_Worker</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USUARIO__</UserId>
      <Delay>PT2M</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USUARIO__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>8</Priority>
    <RestartOnFailure>
      <Interval>PT5M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>"__BASE__\.venv_app\Scripts\pythonw.exe"</Command>
      <Arguments>"__APP__\instalacao\tarefa_worker\iniciar_worker.py"</Arguments>
      <WorkingDirectory>__APP__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
